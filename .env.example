# Get a free API key at https://console.groq.com/keys
#
# This key is shared server-side by EVERY user of this deployment — nobody
# needs to paste their own key into the browser UI. Keep it secret (this
# file should never be committed; only .env.example is checked in).
GROQ_API_KEY=your_groq_api_key_here

# Get a free access token (a "Read" token is enough) at
# https://huggingface.co/settings/tokens
#
# Used ONLY for embeddings, via HF's hosted Inference API (see
# rag_engine.get_embeddings()) instead of loading the model locally with
# torch. This keeps the app's memory footprint small enough to run on
# low-RAM free hosting tiers (e.g. Render's free 512MB web service) —
# loading the model + torch in-process was what OOM-killed the server.
HF_TOKEN=your_huggingface_token_here